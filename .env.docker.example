# Docker / Dokploy shared settings
# Copy to .env and adjust secrets before deploying.
#
# For production: replace APP_KEY and all passwords.
# Generate a key with: php artisan key:generate --show

APP_NAME=FaqHub
APP_ENV=local
APP_KEY=base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=app
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=faqhub
DB_USERNAME=faqhub
DB_PASSWORD=faqhub
DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@faqhub.ir"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=faqhub
REVERB_APP_KEY=faqhub-key
REVERB_APP_SECRET=faqhub-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Host base path for bind mounts:
#   ${FAQHUB_STATIC_PATH}/storage  -> storage/app/public (uploads)
#   ${FAQHUB_STATIC_PATH}/sitemaps -> public/sitemaps
# Production/Dokploy: /opt/faqhub
# Local Windows verify: ./data/faqhub
FAQHUB_STATIC_PATH=./data/faqhub

RUN_STORAGE_LINK=true

# Published host ports
APP_PORT=8000
MYSQL_PORT=3306
REDIS_PORT_PUBLISH=6379
REVERB_PUBLISH_PORT=8080

RUN_MIGRATIONS=true
CACHE_CONFIG=false

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SERVER_URL=
FRONTEND_APP_URL=https://faqhub.ir

SENTRY_LARAVEL_DSN=
